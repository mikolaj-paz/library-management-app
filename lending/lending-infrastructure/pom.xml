<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>lending</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>lending-infrastructure</artifactId>
    <name>Lending :: Infrastructure</name>
    <description>
        Driven adapters - implements domain out-ports.
        Contains: JDBC persistence, repository implementations, mappers,
        messaging adapters, and Spring configuration beans.
        Depends on lending-domain (implements its ports) and lending-application
        (for event publishing hooks if needed).
    </description>

    <dependencies>
        <!-- Domain ports to implement -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>lending-domain</artifactId>
        </dependency>

        <!-- Application layer (for ApplicationEventPublisher wiring if needed) -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>lending-application</artifactId>
        </dependency>

        <!-- Spring JDBC -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- Spring Web annotations and HTTP types for REST input adapters -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- MapStruct — persistence ↔ domain model mappers -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
