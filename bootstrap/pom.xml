<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>library-app</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>bootstrap</artifactId>
    <name>Library :: Bootstrap</name>
    <description>
        Driving adapter - REST entry point. Controllers are thin adapters that
        translate HTTP requests into Commands/Queries and delegate to application services.
        This module wires all layers together and hosts the @SpringBootApplication class.
        Depends on lending-application (use cases), lending-infrastructure (for DI wiring), and catalog-infrastructure (for catalog features).
    </description>

    <dependencies>
        <!-- Application use-case interfaces (what controllers call) -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>lending-application</artifactId>
        </dependency>

        <dependency>
            <groupId>com.example</groupId>
            <artifactId>catalog-application</artifactId>
        </dependency>

        <dependency>
            <groupId>com.example</groupId>
            <artifactId>notifications-application</artifactId>
        </dependency>

        <dependency>
            <groupId>com.example</groupId>
            <artifactId>users-application</artifactId>
        </dependency>

        <!-- Infrastructure pulled in for Spring DI wiring — no direct calls to infra from controllers -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>lending-infrastructure</artifactId>
        </dependency>

        <dependency>
            <groupId>com.example</groupId>
            <artifactId>catalog-infrastructure</artifactId>
        </dependency>

        <dependency>
            <groupId>com.example</groupId>
            <artifactId>notifications-infrastructure</artifactId>
        </dependency>

        <dependency>
            <groupId>com.example</groupId>
            <artifactId>users-infrastructure</artifactId>
        </dependency>

        <!-- Spring Web MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MapStruct — DTO ↔ Command/Query mappers -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- Database runtime for the runnable app (SQLite + JDBC) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Test dependencies — @WebMvcTest slice tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- spring-boot-maven-plugin: packages the fat JAR / runs the app. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>com.example.library.LibraryApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
